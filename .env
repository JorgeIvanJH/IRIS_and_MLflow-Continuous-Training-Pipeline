# MLflow version
MLFLOW_VERSION=3.10.1

# IRIS connection and user settings
IRIS_SERVER=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USERNAME=SuperUser
IRIS_PASSWORD=SYS
